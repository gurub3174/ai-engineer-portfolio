---
import { existsSync } from 'node:fs';
import { fileURLToPath } from 'node:url';
import ContactCard from '@components/ContactCard.astro';
import NavMenu from '@components/NavMenu.astro';
import BaseLayout from '@layouts/BaseLayout.astro';

/*
 * Resume — dedicated route. Displays the PDF inline with the same
 * site-nav + identity as every other page, plus download / open-in-tab
 * actions and the shared contact card.
 *
 * Drop the file at public/resume.pdf; presence is detected at build time.
 */

const resumeFsPath = fileURLToPath(new URL('../../public/resume.pdf', import.meta.url));
const hasResume = existsSync(resumeFsPath);
---

<BaseLayout
  title="Resume · Guru Balamurugan"
  description="One-page resume for Guru Balamurugan, AI/data engineer. View inline or download the PDF."
>
  <a href="#resume" class="skip-link">Skip to the resume</a>

  <header class="site-nav">
    <div class="nav-left">
      <a class="identity" href="/" aria-label="Guru Balamurugan, home">
        <span class="identity-name">Guru Balamurugan</span>
        <span class="identity-sep" aria-hidden="true">·</span>
        <span class="identity-role">AI Engineer</span>
      </a>
      <NavMenu current="resume" />
    </div>

    <nav class="primary-nav" aria-label="Primary">
      <a href="/#studio">Projects</a>
      <a href="/resume" aria-current="page">Resume</a>
      <a href="/about">About</a>
      <a href="/about#get-in-touch">Contact</a>
    </nav>

    <a class="return-link" href="/#studio">
      <span aria-hidden="true">←</span> Return to projects
    </a>
  </header>

  <main id="resume" class="resume">
    <section class="resume-head" aria-labelledby="resume-title">
      <h1 id="resume-title" class="title">Resume</h1>

      {hasResume && (
        <ul class="cta-row" role="list">
          <li>
            <a class="cta cta--primary" href="/resume.pdf" download>
              Download PDF
            </a>
          </li>
          <li>
            <a class="cta" href="/resume.pdf" target="_blank" rel="noopener">
              Open in new tab
            </a>
          </li>
        </ul>
      )}
    </section>

    {hasResume ? (
      <section class="resume-preview" aria-label="Resume preview">
        <div class="resume-frame-wrap">
          <iframe
            class="resume-frame"
            src="/resume.pdf#view=FitH&toolbar=0"
            title="Resume: Guru Balamurugan"
            loading="lazy"
          ></iframe>
          {/* Mobile-only: the inline frame is too small to read, so the whole
              preview becomes a tap target that opens the full PDF. */}
          <a class="resume-open" href="/resume.pdf" target="_blank" rel="noopener">
            <span>Open full resume</span>
          </a>
        </div>
        <p class="resume-fallback">
          Can't see the resume above?{' '}
          <a href="/resume.pdf" target="_blank" rel="noopener">Open the PDF in a new tab.</a>
        </p>
      </section>
    ) : (
      <section class="placeholder" aria-label="Resume placeholder">
        <p class="placeholder-text">
          Resume PDF will be live before launch. Until then, the case studies
          under each project are the better read anyway.
        </p>
        <p class="placeholder-meta">
          Drop a file at <code>public/resume.pdf</code> to enable the inline
          view and download on this page.
        </p>
      </section>
    )}

    <div class="resume-contact">
      <ContactCard />
    </div>
  </main>

  <footer class="page-footer">
    <ul class="footer-links" role="list">
      <li><a href="/">Home</a></li>
      <li><a href="/about">About</a></li>
      <li><a href="/about#get-in-touch">Contact</a></li>
      <li><a href="https://github.com/" rel="me noreferrer">GitHub</a></li>
      <li><a href="https://www.linkedin.com/in/guru17/" rel="me noreferrer">LinkedIn</a></li>
    </ul>
    <p class="footer-meta">Astro · Cloudflare Pages · open source · 2026</p>
  </footer>
</BaseLayout>

<style>
  .skip-link {
    position: absolute;
    left: var(--container-edge);
    top: var(--container-edge);
    padding: var(--space-snug) var(--space-base);
    background: var(--surface-raised);
    color: var(--key-light);
    border: 1px solid var(--border-key);
    border-radius: 2px;
    z-index: 300;
    transform: translateY(-200%);
    transition: transform var(--dur-quick) var(--ease-focus-pull);
  }
  .skip-link:focus-visible {
    transform: translateY(0);
  }

  .site-nav,
  .resume,
  .page-footer {
    width: 100%;
    max-width: var(--container-wide);
    margin-inline: auto;
    padding-inline: var(--container-edge);
  }

  /* Site header — identical recipe to the case-study + about pages. */
  .site-nav {
    padding-top: var(--space-roomy);
    padding-bottom: var(--space-roomy);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-loose);
    flex-wrap: wrap;
  }

  .nav-left {
    display: inline-flex;
    align-items: center;
    gap: var(--space-base);
  }

  /* Mobile-only return link (replaces the horizontal nav on small screens). */
  .return-link {
    display: none;
    font-family: var(--font-mono);
    font-size: var(--fs-caption);
    letter-spacing: var(--ls-meta-allcaps);
    text-transform: uppercase;
    color: var(--ink-muted);
    text-decoration: none;
    align-items: center;
    gap: 0.5ch;
    min-height: 44px;
  }
  .return-link:hover,
  .return-link:focus-visible {
    color: var(--key-light);
  }

  .identity {
    display: inline-flex;
    align-items: baseline;
    gap: var(--space-snug);
    color: var(--ink-strong);
    text-decoration: none;
    font-family: var(--font-mono);
    font-size: var(--fs-caption);
    letter-spacing: var(--ls-meta-allcaps);
    text-transform: uppercase;
    min-height: 44px;
  }

  .identity-sep {
    color: var(--key-light);
  }

  .identity-role {
    color: var(--ink-muted);
  }

  .primary-nav {
    display: inline-flex;
    align-items: center;
    gap: var(--space-loose);
    flex-wrap: wrap;
  }

  .primary-nav a {
    font-family: var(--font-mono);
    font-size: var(--fs-caption);
    color: var(--ink-muted);
    letter-spacing: var(--ls-meta-allcaps);
    text-transform: uppercase;
    text-decoration: none;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    border-bottom: 1px solid transparent;
    transition:
      color var(--dur-quick) var(--ease-focus-pull),
      border-color var(--dur-quick) var(--ease-focus-pull);
  }

  .primary-nav a:hover,
  .primary-nav a:focus-visible {
    color: var(--ink-strong);
    border-bottom-color: var(--key-light);
  }

  .primary-nav a[aria-current='page'] {
    color: var(--ink-strong);
    border-bottom-color: var(--key-light);
  }

  .resume {
    padding-top: var(--space-spacious);
    padding-bottom: var(--space-roomy);
    display: grid;
    gap: var(--space-spacious);
  }

  .resume-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-loose);
  }

  .title {
    font-family: var(--font-display);
    font-size: var(--fs-display);
    font-weight: 600;
    line-height: 0.98;
    letter-spacing: var(--ls-display);
    color: var(--ink-strong);
    margin: 0;
  }

  .cta-row {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    gap: var(--space-loose);
    flex-wrap: wrap;
    align-items: center;
  }

  .cta {
    font-family: var(--font-body);
    font-size: var(--fs-body);
    font-weight: 500;
    color: var(--key-light);
    text-decoration: none;
    padding-bottom: 2px;
    border-bottom: 1px solid currentColor;
    transition:
      color var(--dur-quick) var(--ease-focus-pull),
      border-color var(--dur-quick) var(--ease-focus-pull);
    min-height: 44px;
    display: inline-flex;
    align-items: center;
  }

  .cta:hover,
  .cta:focus-visible {
    color: var(--ink-strong);
    border-color: var(--ink-strong);
  }

  .cta:focus-visible {
    outline: 2px solid var(--key-light);
    outline-offset: 6px;
    border-color: transparent;
  }

  /* Primary CTA — solid warm-tungsten button (matches home hero). */
  .cta--primary {
    color: oklch(0.18 0.012 65);
    background: var(--key-light);
    padding: 0.7rem 1.2rem;
    border: 1px solid var(--key-light);
    border-radius: 2px;
  }

  .cta--primary:hover,
  .cta--primary:focus-visible {
    background: var(--key-light-soft);
    border-color: var(--key-light-soft);
    color: oklch(0.18 0.012 65);
  }

  .cta--primary:focus-visible {
    outline: 2px solid var(--ink-strong);
    outline-offset: 4px;
  }

  /* Inline PDF view. Portrait one-page ratio; scrolls internally if longer. */
  .resume-preview {
    display: grid;
    gap: var(--space-base);
  }

  .resume-frame-wrap {
    position: relative;
    width: 100%;
    max-width: 760px;
    margin-inline: auto;
  }

  .resume-frame {
    width: 100%;
    aspect-ratio: 8.5 / 11;
    border: 1px solid var(--border-hairline);
    border-radius: 3px;
    background: var(--surface-raised);
    display: block;
  }

  /* Tap-to-open overlay: desktop hides it (the frame is readable/interactive);
     mobile shows it because the inline frame is too small to read. */
  .resume-open {
    display: none;
  }

  .resume-fallback {
    margin: 0;
    text-align: center;
    color: var(--ink-faint);
    font-family: var(--font-mono);
    font-size: var(--fs-caption);
  }

  .resume-fallback a {
    color: var(--key-light);
  }

  .placeholder {
    border: 1px dashed var(--border-hairline);
    border-radius: 4px;
    padding: var(--space-spacious);
    text-align: center;
    background: var(--surface-raised);
  }

  .placeholder-text {
    margin: 0 auto;
    color: var(--ink);
    font-size: var(--fs-body-lg);
    max-width: 50ch;
    line-height: 1.5;
  }

  .placeholder-meta {
    margin: var(--space-base) 0 0;
    color: var(--ink-faint);
    font-family: var(--font-mono);
    font-size: var(--fs-caption);
  }

  .placeholder-meta code {
    color: var(--key-light);
    font-family: var(--font-mono);
  }

  .page-footer {
    padding-top: var(--space-spacious);
    padding-bottom: var(--space-roomy);
    border-top: 1px solid var(--border-hairline);
    margin-top: var(--space-roomy);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-base);
    text-align: center;
  }

  .footer-links {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-loose);
  }

  .footer-links a {
    font-family: var(--font-body);
    font-size: var(--fs-small);
  }

  .footer-meta {
    margin: 0;
    font-family: var(--font-mono);
    font-size: var(--fs-caption);
    color: var(--ink-faint);
    letter-spacing: 0.02em;
  }

  @media (max-width: 640px) {
    /* Sticky header; horizontal nav collapses into the dropdown + return link. */
    .site-nav {
      position: sticky;
      top: 0;
      z-index: 100;
      padding-top: var(--space-base);
      padding-bottom: var(--space-base);
      background: var(--bg-stage);
      border-bottom: 1px solid var(--border-hairline);
    }
    .primary-nav {
      display: none;
    }
    .return-link {
      display: inline-flex;
    }

    /* Tighten the gap between the identity bar and the Resume title. */
    .resume {
      padding-top: var(--space-loose);
      gap: var(--space-loose);
    }

    /* Title stacks above full-width actions. */
    .resume-head {
      flex-direction: column;
      align-items: stretch;
      gap: var(--space-loose);
    }
    .cta-row {
      gap: var(--space-base);
    }
    .cta {
      flex: 1 1 auto;
      justify-content: center;
    }

    /* Inline frame becomes a non-interactive preview; the overlay opens the
       full PDF since the inline text is unreadable at phone size. */
    .resume-frame {
      pointer-events: none;
      aspect-ratio: 3 / 4;
    }
    .resume-open {
      display: flex;
      position: absolute;
      inset: 0;
      align-items: flex-end;
      justify-content: center;
      padding: var(--space-loose);
      border-radius: 3px;
      text-decoration: none;
      background: linear-gradient(
        to top,
        oklch(0.05 0.005 65 / 0.82) 0%,
        oklch(0.05 0.005 65 / 0.12) 38%,
        transparent 70%
      );
    }
    .resume-open span {
      font-family: var(--font-body);
      font-size: var(--fs-body);
      font-weight: 500;
      color: oklch(0.18 0.012 65);
      background: var(--key-light);
      padding: 0.7rem 1.2rem;
      border-radius: 2px;
      min-height: 44px;
      display: inline-flex;
      align-items: center;
    }
    .resume-open span::after {
      content: ' →';
      margin-left: 0.3ch;
    }
    .resume-open:focus-visible {
      outline: 2px solid var(--key-light);
      outline-offset: 3px;
    }

    .footer-links {
      gap: var(--space-base);
    }
  }
</style>
