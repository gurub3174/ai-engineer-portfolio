---
import BaseLayout from '@layouts/BaseLayout.astro';
import { Picture } from 'astro:assets';
import homeBg from '@/assets/home-bg.png';
import homeBinder from '@/assets/home-binder.png';
import homeMic from '@/assets/home-mic.png';
import homeBulb from '@/assets/home-bulb.png';

/*
 * Home — Phase 2 (v9, overlay + risks).
 *
 * Changes from v8:
 *   - Site header: identity top-left, nav top-right (replaces old stamp meta-bar).
 *   - Title + subhead + CTAs overlaid on the studio image instead of stacked above it.
 *     Adds .scene-tint gradient on the left of the scene to guarantee AA contrast.
 *   - "Data that works." title line italicized for editorial rhythm.
 *   - Subhead widened to ~70ch (was 60ch). Still inside the impeccable 65–75ch readability law.
 *   - Bulb moved up (y 83→80) so it doesn't run off the table edge.
 *   - New section: "Production risks I design around." Four risks rendered as
 *     editorial plates (serif numeral prefix, image placeholder, body, technique
 *     strip). Dodges the "identical card grid" AI-slop ban via numeral framing.
 *
 * Zero hydrated JS. All interactivity is :has() + CSS transitions.
 */

const subjects = [
  {
    id: 'binder',
    slug: 'doc-extractor',
    name: 'Document extractor',
    tip: 'Layout-aware PDF extraction for PE capital-call notices. Hybrid rules + LLM cut a 6-hour manual process to 12 minutes with 0.4% line-item error.',
    role: 'hero',
    pos: { x: 50, y: 80, w: 28 },
    capGap: '-2rem',
  },
  {
    id: 'mic',
    slug: 'podcast',
    name: 'Podcast pipeline',
    tip: 'Audio sampling pipeline. A 90-minute episode condensed into a 6-bullet research brief, validated against the source transcript.',
    role: 'supporting',
    pos: { x: 74, y: 77, w: 15 },
    capGap: '1rem',
  },
  {
    id: 'bulb',
    slug: 'ai-design-team',
    name: 'AI design team',
    tip: 'Four agents argue a design brief into a finished spec. The argumentation log itself is the deliverable.',
    role: 'supporting',
    pos: { x: 29, y: 80, w: 16 },
    capGap: '-1rem',
  },
];

const risks = [
  {
    n: '01',
    slug: 'bad-inputs',
    title: 'Bad inputs, bad context',
    body: 'AI systems fail when the model receives incomplete, excessive, stale, or irrelevant context.',
    techniques: [
      'Clean ingestion',
      'metadata design',
      'chunking strategy',
      'retrieval testing',
      'context filtering',
    ],
  },
  {
    n: '02',
    slug: 'untrusted-outputs',
    title: 'Untrusted outputs',
    body: 'A fluent answer is not the same as a reliable answer. Outputs need constraints before they can be used.',
    techniques: [
      'Structured outputs',
      'schema validation',
      'confidence flags',
      'business rules',
      'deterministic contracts',
    ],
  },
  {
    n: '03',
    slug: 'no-evaluation-loop',
    title: 'No evaluation loop',
    body: 'Without a formal review process, teams cannot tell whether the system is improving, drifting, or failing.',
    techniques: [
      'Eval sets',
      'human review',
      'editable outputs',
      'approval states',
      'audit trails',
    ],
  },
  {
    n: '04',
    slug: 'silent-failure',
    title: 'Silent failure',
    body: 'If no one can see when the system breaks, the system cannot be trusted.',
    techniques: [
      'Logging',
      'monitoring',
      'exception queues',
      'feedback loops',
      'production alerts',
    ],
  },
];
---

<BaseLayout
  title="Guru Balamurugan · AI Engineer"
  description="AI that ships. Data that works. A portfolio of AI/data engineering work, presented as a small studio of warm light: three projects on a round wooden table under a softbox."
>
  <a href="#studio" class="skip-link">Skip to the studio</a>

  <main>
    <section
      id="studio"
      class="studio"
      aria-label="Studio shoot: three projects on a round wooden table"
    >
      <div class="scene">
        <Picture
          src={homeBg}
          formats={['avif', 'webp']}
          fallbackFormat="jpg"
          widths={[480, 768, 1024, 1440, 1920, 2560, 3200]}
          sizes="100vw"
          alt="Empty studio scene: a round wooden table lit by a softbox on the left, against a deep warm cove background."
          loading="eager"
          fetchpriority="high"
          quality={78}
          pictureAttributes={{ class: 'scene-bg' }}
        />

        <div class="scene-tint" aria-hidden="true"></div>

        <header class="site-nav">
          <div class="site-nav-inner">
            <a class="identity" href="/" aria-label="Guru Balamurugan — home">
              <span class="identity-name">Guru Balamurugan</span>
              <span class="identity-sep" aria-hidden="true">·</span>
              <span class="identity-role">AI Engineer</span>
            </a>

            <nav class="primary-nav" aria-label="Primary">
              <a href="#studio">Projects</a>
              <a href="/resume">Resume</a>
              <a href="/about">About</a>
              <a href="/contact">Contact</a>
            </nav>
          </div>
        </header>

        <div class="scene-overlay" aria-labelledby="title">
          <h1 id="title" class="title">
            <span class="title-line">AI that ships.</span>
            <span class="title-line title-line--soft">Data that works.</span>
          </h1>

          <p class="subhead">
            AI prototypes are easy to impress with and hard to trust. I bring a data
            engineering foundation to AI engineering, building the data, retrieval,
            evaluation, and operational layers that turn promising demos into reliable
            production systems.
          </p>

          <ul class="cta-row" role="list">
            <li>
              <a class="cta cta--primary" href="#risks">
                Explore projects
              </a>
            </li>
            <li>
              <a class="cta cta--quiet" href="/resume">
                View resume
              </a>
            </li>
          </ul>
        </div>

        <ol class="products" role="list">
          {subjects.map((s) => (
            <li
              class={`product product--${s.id} ${s.role === 'hero' ? 'is-default' : ''}`}
              style={`--px: ${s.pos.x}%; --py: ${s.pos.y}%; --pw: ${s.pos.w}%; --cap-gap: ${s.capGap};`}
            >
              <a
                class={`product-link product-link--${s.id}`}
                href={`/projects/${s.slug}`}
                aria-describedby={`tip-${s.id}`}
              >
                <span class="cutout-wrap">
                  {s.id === 'binder' && (
                    <Picture
                      src={homeBinder}
                      formats={['avif', 'webp']}
                      fallbackFormat="png"
                      widths={[200, 320, 480, 640]}
                      sizes="(min-width: 1280px) 320px, (min-width: 768px) 25vw, 30vw"
                      alt=""
                      loading="eager"
                      quality={78}
                    />
                  )}
                  {s.id === 'mic' && (
                    <Picture
                      src={homeMic}
                      formats={['avif', 'webp']}
                      fallbackFormat="png"
                      widths={[140, 220, 320]}
                      sizes="(min-width: 1280px) 140px, (min-width: 768px) 10vw, 14vw"
                      alt=""
                      loading="eager"
                      quality={78}
                    />
                  )}
                  {s.id === 'bulb' && (
                    <Picture
                      src={homeBulb}
                      formats={['avif', 'webp']}
                      fallbackFormat="png"
                      widths={[140, 220, 320]}
                      sizes="(min-width: 1280px) 150px, (min-width: 768px) 11vw, 15vw"
                      alt=""
                      loading="eager"
                      quality={78}
                    />
                  )}
                </span>
                <span class="caption">
                  <span class="name">{s.name}</span>
                </span>
              </a>
              <p
                id={`tip-${s.id}`}
                class={`tip tip--${s.id}`}
                role="tooltip"
              >
                {s.tip}
              </p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section id="risks" class="risks" aria-labelledby="risks-title">
      <header class="risks-head">
        <p class="risks-eyebrow">Selected · risks</p>
        <h2 id="risks-title" class="risks-title">
          Production risks I design around.
        </h2>
        <p class="risks-deck">
          The work is organized around what fails in production, not which model is in fashion.
          Each plate below names a failure mode and the engineering layer that prevents it.
        </p>
      </header>

      <ol class="risk-grid" role="list">
        {risks.map((r) => (
          <li class={`risk risk--${r.slug}`}>
            <div class="risk-thumb" aria-hidden="true">
              <span class="risk-thumb-meta">Plate / placeholder</span>
            </div>
            <div class="risk-body">
              <p class="risk-number">
                <span class="risk-number-numeral">{r.n}</span>
                <span class="risk-number-slash">/</span>
              </p>
              <h3 class="risk-title">{r.title}</h3>
              <p class="risk-text">{r.body}</p>
              <p class="risk-techniques">
                {r.techniques.map((t, i) => (
                  <>
                    {i > 0 && <span class="risk-tech-sep" aria-hidden="true"> · </span>}
                    <span class="risk-tech">{t}</span>
                  </>
                ))}
              </p>
            </div>
          </li>
        ))}
      </ol>
    </section>
  </main>

  <footer class="page-footer">
    <p class="footer-line">
      The work, lit and labeled. Case studies under each subject.
    </p>
    <ul class="footer-links" role="list">
      <li><a href="https://github.com/" rel="me noreferrer">GitHub</a></li>
      <li><a href="https://www.linkedin.com/" rel="me noreferrer">LinkedIn</a></li>
      <li><a href="/about">About</a></li>
      <li><a href="/contact">Contact</a></li>
    </ul>
    <p class="footer-meta">Astro · Cloudflare Pages · open source · 2026</p>
  </footer>
</BaseLayout>

<style>
  /* ============================================================
   * Skip link
   * ============================================================ */
  .skip-link {
    position: absolute;
    left: var(--container-edge);
    top: var(--container-edge);
    padding: var(--space-snug) var(--space-base);
    background: var(--surface-raised);
    color: var(--key-light);
    border: 1px solid var(--border-key);
    border-radius: 2px;
    z-index: 300;
    transform: translateY(-200%);
    transition: transform var(--dur-quick) var(--ease-focus-pull);
  }

  .skip-link:focus-visible {
    transform: translateY(0);
  }

  /* ============================================================
   * Shell — only the content sections below the hero stay constrained.
   * Studio + site-nav are full-bleed inside the hero scene.
   * ============================================================ */
  .risks,
  .page-footer {
    width: 100%;
    max-width: var(--container-wide);
    margin-inline: auto;
    padding-inline: var(--container-edge);
  }

  /* ============================================================
   * Site header — overlaid on the studio image (top edge of scene).
   * Inner wrapper carries the content-width alignment so identity and
   * primary-nav still line up with the risks / footer sections below.
   * ============================================================ */
  .site-nav {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    z-index: 4;
    padding-block: var(--space-roomy) var(--space-loose);
    pointer-events: none;
  }

  .site-nav-inner {
    max-width: var(--container-wide);
    margin-inline: auto;
    padding-inline: var(--container-edge);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-loose);
    flex-wrap: wrap;
    pointer-events: auto;
  }

  .identity {
    display: inline-flex;
    align-items: baseline;
    gap: 0.45ch;
    text-decoration: none;
    color: inherit;
    font-family: var(--font-display);
  }

  .identity-name {
    font-size: var(--fs-body-lg);
    font-weight: 600;
    color: var(--ink-strong);
    letter-spacing: var(--ls-heading);
  }

  .identity-sep {
    color: var(--ink-faint);
    font-size: var(--fs-body-lg);
  }

  .identity-role {
    font-family: var(--font-mono);
    font-size: var(--fs-caption);
    color: var(--ink-faint);
    letter-spacing: var(--ls-meta-allcaps);
    text-transform: uppercase;
    align-self: center;
    margin-left: 0.4ch;
  }

  .primary-nav {
    display: flex;
    gap: var(--space-loose);
    flex-wrap: wrap;
  }

  .primary-nav a {
    font-family: var(--font-body);
    font-size: var(--fs-small);
    color: var(--ink-muted);
    text-decoration: none;
    padding: var(--space-tight) 0;
    border-bottom: 1px solid transparent;
    transition:
      color var(--dur-quick) var(--ease-focus-pull),
      border-color var(--dur-quick) var(--ease-focus-pull);
    min-height: 44px;
    display: inline-flex;
    align-items: center;
  }

  .primary-nav a:hover,
  .primary-nav a:focus-visible {
    color: var(--ink-strong);
    border-bottom-color: var(--key-light);
  }

  .primary-nav a:focus-visible {
    outline: 2px solid var(--key-light);
    outline-offset: 4px;
  }

  /* ============================================================
   * Studio scene — full-bleed letterbox hero, no side gutters.
   * ============================================================ */
  .studio {
    position: relative;
    width: 100%;
    margin: 0;
    overflow: visible;
    scroll-margin-top: 6vh;
  }

  .scene {
    position: relative;
    width: 100%;
    min-height: 70vh;
    aspect-ratio: 21 / 9;
    overflow: hidden;
  }

  :global(.scene-bg),
  :global(.scene-bg img) {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
  }

  :global(.scene-bg) {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  :global(.scene-bg img) {
    transition:
      filter var(--dur-considered) var(--ease-illuminate);
  }

  /* Contrast tint — top + left compound gradient. Top layer covers the
     nav row; left layer covers identity and title. Both fade out toward
     the products so the photograph stays visible there. */
  .scene-tint {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background:
      linear-gradient(
        180deg,
        oklch(0.07 0.005 65 / 0.55) 0%,
        oklch(0.07 0.005 65 / 0.30) 14%,
        transparent 28%
      ),
      linear-gradient(
        100deg,
        oklch(0.07 0.005 65 / 0.72) 0%,
        oklch(0.07 0.005 65 / 0.52) 26%,
        oklch(0.07 0.005 65 / 0.18) 55%,
        transparent 75%
      );
  }

  /* Background dim on product hover — combined with the focused-product halo */
  .studio:has(.product-link:hover) :global(.scene-bg img),
  .studio:has(.product-link:focus-visible) :global(.scene-bg img) {
    filter: brightness(0.50) saturate(0.85);
  }

  /* ============================================================
   * Overlay — title + subhead + CTAs sit on the photograph
   * ============================================================ */
  .scene-overlay {
    position: absolute;
    z-index: 2;
    top: 18%;
    left: 5%;
    right: auto;
    width: min(62%, 46rem);
    padding: 0;
    pointer-events: none;
  }

  .scene-overlay > * {
    pointer-events: auto;
  }

  .title {
    font-family: var(--font-display);
    font-size: var(--fs-display);
    font-weight: 600;
    line-height: 0.98;
    letter-spacing: var(--ls-display);
    color: var(--ink-strong);
    margin: 0;
    max-width: 18ch;
    text-wrap: balance;
    display: flex;
    flex-direction: column;
    gap: 0.04em;
  }

  .title-line {
    display: block;
  }

  .title-line--soft {
    font-style: italic;
    color: var(--ink-muted);
  }

  .subhead {
    margin: var(--space-base) 0 0;
    max-width: 70ch;
    color: var(--ink);
    font-family: var(--font-body);
    font-size: var(--fs-body-lg);
    line-height: 1.5;
  }

  .cta-row {
    list-style: none;
    margin: var(--space-loose) 0 0;
    padding: 0;
    display: flex;
    gap: var(--space-loose);
    flex-wrap: wrap;
  }

  .cta {
    font-family: var(--font-body);
    font-size: var(--fs-body);
    font-weight: 500;
    color: var(--key-light);
    text-decoration: none;
    padding-bottom: 2px;
    border-bottom: 1px solid currentColor;
    transition:
      color var(--dur-quick) var(--ease-focus-pull),
      border-color var(--dur-quick) var(--ease-focus-pull);
    min-height: 44px;
    display: inline-flex;
    align-items: center;
  }

  .cta::after {
    content: ' →';
    white-space: nowrap;
    margin-left: 0.2ch;
    transition: transform var(--dur-quick) var(--ease-focus-pull);
    display: inline-block;
  }

  .cta:hover,
  .cta:focus-visible {
    color: var(--ink-strong);
    border-color: var(--ink-strong);
  }

  .cta:hover::after,
  .cta:focus-visible::after {
    transform: translateX(3px);
  }

  .cta:focus-visible {
    outline: 2px solid var(--key-light);
    outline-offset: 6px;
    border-color: transparent;
  }

  .cta--quiet {
    color: var(--ink-muted);
  }

  /* ============================================================
   * Products — layered cutouts on the table
   * ============================================================ */
  .products {
    position: absolute;
    inset: 0;
    z-index: 3;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .product {
    position: absolute;
    left: var(--px);
    top: var(--py);
    width: var(--pw);
    transform: translate(-50%, -100%);
    margin: 0;
    padding: 0;
  }

  .product-link {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-decoration: none;
    border: none;
    color: inherit;
    min-height: 44px;
    min-width: 44px;
    border-radius: 4px;
    cursor: pointer;
  }

  .product-link:focus-visible {
    outline: 2px solid var(--key-light);
    outline-offset: 8px;
  }

  .cutout-wrap {
    display: block;
    width: 100%;
    line-height: 0;
    filter:
      blur(2.5px)
      brightness(0.86)
      saturate(0.92);
    transition:
      filter var(--dur-considered) var(--ease-focus-pull),
      transform var(--dur-considered) var(--ease-focus-pull);
    will-change: filter, transform;
  }

  .cutout-wrap :global(picture),
  .cutout-wrap :global(img) {
    display: block;
    width: 100%;
    height: auto;
  }

  /* Highlight recipe — halo + camera focus + filament ignition */
  .product.is-default .cutout-wrap,
  .products:has(.product-link--binder:hover) .product--binder .cutout-wrap,
  .products:has(.product-link--binder:focus-visible) .product--binder .cutout-wrap,
  .products:has(.product-link--mic:hover) .product--mic .cutout-wrap,
  .products:has(.product-link--mic:focus-visible) .product--mic .cutout-wrap {
    filter:
      brightness(1.12)
      saturate(1.06)
      drop-shadow(0 0 26px oklch(0.74 0.155 65 / 0.45))
      drop-shadow(8px 12px 14px oklch(0.04 0.003 65 / 0.55));
    transform: scale(1.025);
  }

  .products:has(.product-link--bulb:hover) .product--bulb .cutout-wrap,
  .products:has(.product-link--bulb:focus-visible) .product--bulb .cutout-wrap {
    filter:
      brightness(1.32)
      saturate(1.22)
      drop-shadow(0 0 36px oklch(0.74 0.155 65 / 0.65))
      drop-shadow(0 0 14px oklch(0.82 0.085 78 / 0.45))
      drop-shadow(8px 12px 14px oklch(0.04 0.003 65 / 0.55));
    transform: scale(1.025);
    transition:
      filter var(--dur-cinematic) var(--ease-illuminate),
      transform var(--dur-considered) var(--ease-focus-pull);
  }

  .products:has(.product-link--mic:hover) .product--binder .cutout-wrap,
  .products:has(.product-link--mic:focus-visible) .product--binder .cutout-wrap,
  .products:has(.product-link--bulb:hover) .product--binder .cutout-wrap,
  .products:has(.product-link--bulb:focus-visible) .product--binder .cutout-wrap {
    filter:
      blur(2.5px)
      brightness(0.86)
      saturate(0.92);
    transform: none;
  }

  /* Captions */
  .caption {
    display: flex;
    flex-direction: column;
    align-items: center;
    margin-top: var(--cap-gap, 0.5rem);
    text-align: center;
    transition:
      opacity var(--dur-quick) var(--ease-focus-pull),
      color var(--dur-quick) var(--ease-focus-pull);
    opacity: 0.7;
  }

  .name {
    font-family: var(--font-display);
    font-size: var(--fs-small);
    color: var(--ink);
    font-weight: 600;
    line-height: 1.2;
    white-space: nowrap;
  }

  .product.is-default .caption,
  .products:has(.product-link--binder:hover) .product--binder .caption,
  .products:has(.product-link--binder:focus-visible) .product--binder .caption,
  .products:has(.product-link--mic:hover) .product--mic .caption,
  .products:has(.product-link--mic:focus-visible) .product--mic .caption,
  .products:has(.product-link--bulb:hover) .product--bulb .caption,
  .products:has(.product-link--bulb:focus-visible) .product--bulb .caption {
    opacity: 1;
  }

  .product.is-default .name,
  .products:has(.product-link--binder:hover) .product--binder .name,
  .products:has(.product-link--binder:focus-visible) .product--binder .name,
  .products:has(.product-link--mic:hover) .product--mic .name,
  .products:has(.product-link--mic:focus-visible) .product--mic .name,
  .products:has(.product-link--bulb:hover) .product--bulb .name,
  .products:has(.product-link--bulb:focus-visible) .product--bulb .name {
    color: var(--key-light);
  }

  .products:has(.product-link--mic:hover) .product--binder .caption,
  .products:has(.product-link--mic:focus-visible) .product--binder .caption,
  .products:has(.product-link--bulb:hover) .product--binder .caption,
  .products:has(.product-link--bulb:focus-visible) .product--binder .caption {
    opacity: 0.7;
  }

  .products:has(.product-link--mic:hover) .product--binder .name,
  .products:has(.product-link--mic:focus-visible) .product--binder .name,
  .products:has(.product-link--bulb:hover) .product--binder .name,
  .products:has(.product-link--bulb:focus-visible) .product--binder .name {
    color: var(--ink);
  }

  /* Tip — hover-revealed description anchored above the cutout */
  .tip {
    position: absolute;
    bottom: calc(100% + 0.5rem);
    left: 50%;
    transform: translateX(-50%) translateY(0.4rem);
    width: max-content;
    max-width: 26ch;
    margin: 0;
    padding: var(--space-snug) var(--space-base);
    background: var(--surface-raised);
    border: 1px solid var(--border-hairline);
    border-radius: 3px;
    color: var(--ink);
    font-family: var(--font-body);
    font-size: var(--fs-small);
    line-height: 1.4;
    text-align: center;
    opacity: 0;
    pointer-events: none;
    transition:
      opacity var(--dur-quick) var(--ease-focus-pull),
