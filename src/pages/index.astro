---
import BaseLayout from '@layouts/BaseLayout.astro';
import { Picture } from 'astro:assets';
import homeBg from '@/assets/home-bg-wide.png';
import homeBinder from '@/assets/home-binder.png';
import homeMic from '@/assets/home-mic.png';
import homeBulb from '@/assets/home-bulb.png';

/*
 * Home — Phase 2 (v11, wide background + 4-up risks).
 *
 * Changes from v10:
 *   - Background swapped to home-bg-wide.png — wider studio composition with
 *     softbox left-of-center and the round table on the right.
 *   - Scene goes fully bleed-to-edge (100vw, no container clamp).
 *   - Site header floats over the scene: identity top-left, nav top-right,
 *     no padded shell — visual gutter only via padding-inline on .site-nav.
 *   - Hero copy block stays on the left third of the scene; widths re-tuned
 *     so the title clears the softbox in the bg image.
 *   - Products re-anchored to the right-side table: bulb (left of binder)
 *     63%, binder hero 76%, mic 90%. Same hover/highlight recipe.
 *   - "Production risks" grid: 2x2 → 1x4 row, plate proportions adjusted
 *     so four columns read at desktop widths without crowding.
 *
 * Zero hydrated JS. All interactivity is :has() + CSS transitions.
 */

const subjects = [
  {
    id: 'binder',
    slug: 'doc-extractor',
    name: 'Document extractor',
    tip: 'Layout-aware PDF extraction for PE capital-call notices. Hybrid rules + LLM cut a 6-hour manual process to 12 minutes with 0.4% line-item error.',
    role: 'hero',
    pos: { x: 72, y: 76, w: 20 },
    capGap: '-2rem',
  },
  {
    id: 'mic',
    slug: 'podcast',
    name: 'Podcast pipeline',
    tip: 'Audio sampling pipeline. A 90-minute episode condensed into a 6-bullet research brief, validated against the source transcript.',
    role: 'supporting',
    pos: { x: 88, y: 74, w: 10 },
    capGap: '1rem',
  },
  {
    id: 'bulb',
    slug: 'ai-design-team',
    name: 'AI design team',
    tip: 'Four agents argue a design brief into a finished spec. The argumentation log itself is the deliverable.',
    role: 'supporting',
    pos: { x: 56, y: 76, w: 11 },
    capGap: '-1rem',
  },
];

const risks = [
  {
    n: '01',
    slug: 'bad-inputs',
    title: 'Bad inputs, bad context',
    body: 'The model gets incomplete, excessive, stale, or irrelevant context.',
    techniques: [
      'Clean ingestion',
      'metadata design',
      'retrieval testing',
      'context filtering',
    ],
  },
  {
    n: '02',
    slug: 'untrusted-outputs',
    title: 'Untrusted outputs',
    body: 'Fluent answers can look correct before they are actually reliable.',
    techniques: [
      'Structured outputs',
      'schema validation',
      'confidence flags',
      'business rules',
    ],
  },
  {
    n: '03',
    slug: 'no-evaluation-loop',
    title: 'No evaluation loop',
    body: 'Without review, teams cannot measure drift, quality, or failure.',
    techniques: [
      'Eval sets',
      'human review',
      'approval states',
      'audit trails',
    ],
  },
  {
    n: '04',
    slug: 'silent-failure',
    title: 'Silent failure',
    body: 'Systems break quietly unless their behavior is observable.',
    techniques: [
      'Logging',
      'monitoring',
      'exception queues',
      'feedback loops',
    ],
  },
];
---

<BaseLayout
  title="Guru Balamurugan · AI Engineer"
  description="AI that ships. Data that works. A portfolio of AI/data engineering work, presented as a small studio of warm light: three projects on a round wooden table under a softbox."
>
  <a href="#studio" class="skip-link">Skip to the studio</a>

  <main>
    <section
      id="studio"
      class="studio"
      aria-label="Studio shoot: three projects on a round wooden table"
    >
      <div class="scene">
        <Picture
          src={homeBg}
          formats={['avif', 'webp']}
          fallbackFormat="jpg"
          widths={[768, 1280, 1600, 2000, 2400]}
          sizes="100vw"
          alt="Empty studio scene: a round wooden table on the right lit by a softbox on the left, against a deep warm cove background."
          loading="eager"
          fetchpriority="high"
          quality={80}
          pictureAttributes={{ class: 'scene-bg' }}
        />

        <div class="scene-tint" aria-hidden="true"></div>

        <header class="site-nav">
          <a class="identity" href="/" aria-label="Guru Balamurugan, home">
            <span class="identity-name">Guru Balamurugan</span>
            <span class="identity-sep" aria-hidden="true">·</span>
            <span class="identity-role">AI Engineer</span>
          </a>

          <nav class="primary-nav" aria-label="Primary">
            <a href="#risks">Projects</a>
            <a href="/resume">Resume</a>
            <a href="/about">About</a>
            <a href="/contact">Contact</a>
          </nav>
        </header>

        <div class="scene-overlay" aria-labelledby="title">
          <h1 id="title" class="title">
            <span class="title-line">AI that ships.</span>
            <span class="title-line title-line--soft">Data that works.</span>
          </h1>

          <p class="subhead">
            AI prototypes are easy to impress with and hard to trust. I bring a
            data engineering foundation to AI engineering, building the retrieval,
            evaluation, and operational layers that turn promising demos into
            reliable production systems.
          </p>

          <ul class="cta-row" role="list">
            <li>
              <a class="cta cta--primary" href="#risks">
                Explore projects
              </a>
            </li>
            <li>
              <a class="cta cta--quiet" href="/resume">
                View resume
              </a>
            </li>
          </ul>
        </div>

        <ol class="products" role="list">
          {subjects.map((s) => (
            <li
              class={`product product--${s.id} ${s.role === 'hero' ? 'is-default' : ''}`}
              style={`--px: ${s.pos.x}%; --py: ${s.pos.y}%; --pw: ${s.pos.w}%; --cap-gap: ${s.capGap};`}
            >
              <a
                class={`product-link product-link--${s.id}`}
                href={`/projects/${s.slug}`}
                aria-describedby={`tip-${s.id}`}
              >
                <span class="cutout-wrap">
                  {s.id === 'binder' && (
                    <Picture
                      src={homeBinder}
                      formats={['avif', 'webp']}
                      fallbackFormat="png"
                      widths={[200, 320, 480, 640]}
                      sizes="(min-width: 1280px) 320px, (min-width: 768px) 22vw, 28vw"
                      alt=""
                      loading="eager"
                      quality={78}
                    />
                  )}
                  {s.id === 'mic' && (
                    <Picture
                      src={homeMic}
                      formats={['avif', 'webp']}
                      fallbackFormat="png"
                      widths={[140, 220, 320]}
                      sizes="(min-width: 1280px) 130px, (min-width: 768px) 9vw, 12vw"
                      alt=""
                      loading="eager"
                      quality={78}
                    />
                  )}
                  {s.id === 'bulb' && (
                    <Picture
                      src={homeBulb}
                      formats={['avif', 'webp']}
                      fallbackFormat="png"
                      widths={[140, 220, 320]}
                      sizes="(min-width: 1280px) 140px, (min-width: 768px) 10vw, 14vw"
                      alt=""
                      loading="eager"
                      quality={78}
                    />
                  )}
                </span>
                <span class="caption">
                  <span class="name">{s.name}</span>
                </span>
              </a>
              <p
                id={`tip-${s.id}`}
                class={`tip tip--${s.id}`}
                role="tooltip"
              >
                {s.tip}
              </p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section id="risks" class="risks" aria-labelledby="risks-title">
      <header class="risks-head">
        <h2 id="risks-title" class="risks-title">
          Production risks I design around.
        </h2>
      </header>

      <ol class="risk-grid" role="list">
        {risks.map((r) => (
          <li class={`risk risk--${r.slug}`}>
            <p class="risk-number">
              <span class="risk-number-numeral">{r.n}</span>
            </p>
            <h3 class="risk-title">{r.title}</h3>

            <p class="risk-label">Failure pattern</p>
            <p class="risk-text">{r.body}</p>

            <p class="risk-label risk-label--response">Design response</p>
            <p class="risk-techniques">
              {r.techniques.map((t, i) => (
                <>
                  {i > 0 && <span class="risk-tech-sep" aria-hidden="true"> · </span>}
                  <span class="risk-tech">{t}</span>
                </>
              ))}
            </p>
          </li>
        ))}
      </ol>
    </section>
  </main>

  <footer class="page-footer">
    <p class="footer-line">
      The work, lit and labeled. Case studies under each subject.
    </p>
    <ul class="footer-links" role="list">
      <li><a href="https://github.com/" rel="me noreferrer">GitHub</a></li>
      <li><a href="https://www.linkedin.com/" rel="me noreferrer">LinkedIn</a></li>
      <li><a href="/about">About</a></li>
      <li><a href="/contact">Contact</a></li>
    </ul>
    <p class="footer-meta">Astro · Cloudflare Pages · open source · 2026</p>
  </footer>
</BaseLayout>

<style>
  /* ============================================================
   * Skip link
   * ============================================================ */
  .skip-link {
    position: absolute;
    left: var(--container-edge);
    top: var(--container-edge);
    padding: var(--space-snug) var(--space-base);
    background: var(--surface-raised);
    color: var(--key-light);
    border: 1px solid var(--border-key);
    border-radius: 2px;
    z-index: 300;
    transform: translateY(-200%);
    transition: transform var(--dur-quick) var(--ease-focus-pull);
  }

  .skip-link:focus-visible {
    transform: translateY(0);
  }

  /* ============================================================
   * Shell — risks + footer stay inside container; studio is full-bleed.
   * ============================================================ */
  .risks,
  .page-footer {
    width: 100%;
    max-width: var(--container-wide);
    margin-inline: auto;
    padding-inline: var(--container-edge);
  }

  /* ============================================================
   * Studio scene — full-bleed hero
   * ============================================================ */
  .studio {
    position: relative;
    width: 100%;
    margin: 0;
    overflow: visible;
    scroll-margin-top: 6vh;
  }

  .scene {
    position: relative;
    width: 100%;
    /* Matches native ratio of src/assets/home-bg-wide.png after the crop
       script runs. Re-run scripts/crop-home-bg.mjs with a different pixel
       value and paste the printed ratio here.
       To shrink the hero further: lower min-height. To grow it: raise. */
    aspect-ratio: 1832 / 759;
    min-height: 420px;
    max-height: 78vh;
    overflow: hidden;
    border: none;
  }

  :global(.scene-bg),
  :global(.scene-bg img) {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
    object-position: center;
  }

  :global(.scene-bg) {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  :global(.scene-bg img) {
    transition:
      filter var(--dur-considered) var(--ease-illuminate);
  }

  /* Two-layer contrast tint:
       (1) Top band — protects the nav text on the right side of the scene
           where the bg has bright softbox illumination. ~120px deep, hard
           anchor at top, full fade by the time it reaches the hero title.
       (2) Left wash — original left-to-right gradient that guarantees AA
           contrast for the overlaid title + subhead. */
  .scene-tint {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background:
      linear-gradient(
        to bottom,
        oklch(0.05 0.005 65 / 0.62) 0px,
        oklch(0.05 0.005 65 / 0.30) 80px,
        transparent 140px
      ),
      linear-gradient(
        100deg,
        oklch(0.06 0.005 65 / 0.78) 0%,
        oklch(0.06 0.005 65 / 0.58) 22%,
        oklch(0.06 0.005 65 / 0.22) 48%,
        transparent 68%
      );
  }

  /* Background dim on product hover — combined with the focused-product halo */
  .studio:has(.product-link:hover) :global(.scene-bg img),
  .studio:has(.product-link:focus-visible) :global(.scene-bg img) {
    filter: brightness(0.55) saturate(0.85);
  }

  /* ============================================================
   * Site header — overlaid on the scene
   * ============================================================ */
  .site-nav {
    position: absolute;
    z-index: 4;
    top: 0;
    left: 0;
    right: 0;
    padding: var(--space-roomy) clamp(var(--container-edge), 4vw, 3.5rem);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-loose);
    flex-wrap: wrap;
  }

  .identity {
    display: inline-flex;
    align-items: baseline;
    gap: 0.55ch;
    text-decoration: none;
    color: inherit;
    font-family: var(--font-mono);
    text-transform: uppercase;
    letter-spacing: var(--ls-meta-allcaps);
  }

  .identity-name {
    font-size: var(--fs-small);
    font-weight: 500;
    color: var(--ink-strong);
  }

  .identity-sep {
    color: var(--key-light);
    font-size: var(--fs-small);
  }

  .identity-role {
    font-size: var(--fs-small);
    color: var(--key-light);
    font-weight: 500;
  }

  .primary-nav {
    display: flex;
    gap: var(--space-roomy);
    flex-wrap: wrap;
  }

  .primary-nav a {
    font-family: var(--font-body);
    font-size: var(--fs-body);
    color: var(--ink-strong);
    text-decoration: none;
    padding: var(--space-tight) 0;
    border-bottom: 1px solid transparent;
    transition:
      color var(--dur-quick) var(--ease-focus-pull),
      border-color var(--dur-quick) var(--ease-focus-pull);
    min-height: 44px;
    display: inline-flex;
    align-items: center;
  }

  .primary-nav a:first-child {
    color: var(--key-light);
  }

  .primary-nav a:hover,
  .primary-nav a:focus-visible {
    color: var(--key-light);
    border-bottom-color: var(--key-light);
  }

  .primary-nav a:focus-visible {
    outline: 2px solid var(--key-light);
    outline-offset: 4px;
  }

  /* ============================================================
   * Overlay — title + subhead + CTAs on the left of the scene
   * ============================================================ */
  .scene-overlay {
    position: absolute;
    z-index: 2;
    top: 22%;
    left: clamp(var(--container-edge), 4vw, 3.5rem);
    right: auto;
    width: min(46%, 36rem);
    padding: 0;
    pointer-events: none;
  }

  .scene-overlay > * {
    pointer-events: auto;
  }

  .title {
    font-family: var(--font-display);
    font-size: var(--fs-display);
    font-weight: 600;
    line-height: 1.02;
    letter-spacing: var(--ls-display);
    color: var(--ink-strong);
    margin: 0;
    max-width: 16ch;
    text-wrap: balance;
    display: flex;
    flex-direction: column;
    gap: 0.04em;
  }

  .title-line {
    display: block;
  }

  .title-line--soft {
    color: var(--ink-strong);
  }

  .subhead {
    margin: var(--space-loose) 0 0;
    max-width: 48ch;
    color: var(--ink);
    font-family: var(--font-body);
    font-size: var(--fs-body-lg);
    line-height: 1.5;
  }

  .cta-row {
    list-style: none;
    margin: var(--space-roomy) 0 0;
    padding: 0;
    display: flex;
    gap: var(--space-roomy);
    align-items: center;
    flex-wrap: wrap;
  }

  /* Primary CTA — solid warm-tungsten button (key-light fill) */
  .cta--primary {
    font-family: var(--font-body);
    font-size: var(--fs-body);
    font-weight: 500;
    color: oklch(0.18 0.012 65);
    background: var(--key-light);
    text-decoration: none;
    padding: 0.85rem 1.4rem;
    border: 1px solid var(--key-light);
    border-radius: 2px;
    transition:
      background var(--dur-quick) var(--ease-focus-pull),
      color var(--dur-quick) var(--ease-focus-pull),
      transform var(--dur-quick) var(--ease-focus-pull);
    min-height: 44px;
    display: inline-flex;
    align-items: center;
  }

  .cta--primary:hover,
  .cta--primary:focus-visible {
    background: var(--key-light-soft);
    border-color: var(--key-light-soft);
    transform: translateY(-1px);
  }

  .cta--primary:focus-visible {
    outline: 2px solid var(--ink-strong);
    outline-offset: 4px;
  }

  /* Quiet CTA — text link with arrow, key-light tone */
  .cta--quiet {
    font-family: var(--font-body);
    font-size: var(--fs-body);
    font-weight: 500;
    color: var(--key-light);
    text-decoration: none;
    padding-bottom: 2px;
    border-bottom: 1px solid currentColor;
    transition:
      color var(--dur-quick) var(--ease-focus-pull),
      border-color var(--dur-quick) var(--ease-focus-pull);
    min-height: 44px;
    display: inline-flex;
    align-items: center;
  }

  .cta--quiet::after {
    content: ' →';
    white-space: nowrap;
    margin-left: 0.3ch;
    transition: transform var(--dur-quick) var(--ease-focus-pull);
    display: inline-block;
  }

  .cta--quiet:hover,
  .cta--quiet:focus-visible {
    color: var(--ink-strong);
    border-color: var(--ink-strong);
  }

  .cta--quiet:hover::after,
  .cta--quiet:focus-visible::after {
    transform: translateX(3px);
  }

  .cta--quiet:focus-visible {
    outline: 2px solid var(--key-light);
    outline-offset: 6px;
    border-color: transparent;
  }

  /* ============================================================
   * Products — layered cutouts on the table (right side)
   * ============================================================ */
  .products {
    position: absolute;
    inset: 0;
    z-index: 3;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .product {
    position: absolute;
    left: var(--px);
    top: var(--py);
    width: var(--pw);
    transform: translate(-50%, -100%);
    margin: 0;
    padding: 0;
  }

  .product-link {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-decoration: none;
    border: none;
    color: inherit;
    min-height: 44px;
    min-width: 44px;
    border-radius: 4px;
    cursor: pointer;
  }

  .product-link:focus-visible {
    outline: 2px solid var(--key-light);
    outline-offset: 8px;
  }

  .cutout-wrap {
    display: block;
    width: 100%;
    line-height: 0;
    filter:
      blur(2.5px)
      brightness(0.86)
      saturate(0.92);
    transition:
      filter var(--dur-considered) var(--ease-focus-pull),
      transform var(--dur-considered) var(--ease-focus-pull);
    will-change: filter, transform;
  }

  .cutout-wrap :global(picture),
  .cutout-wrap :global(img) {
    display: block;
    width: 100%;
    height: auto;
  }

  /* Highlight recipe — halo + camera focus + filament ignition */
  .product.is-default .cutout-wrap,
  .products:has(.product-link--binder:hover) .product--binder .cutout-wrap,
  .products:has(.product-link--binder:focus-visible) .product--binder .cutout-wrap,
  .products:has(.product-link--mic:hover) .product--mic .cutout-wrap,
  .products:has(.product-link--mic:focus-visible) .product--mic .cutout-wrap {
    filter:
      brightness(1.12)
      saturate(1.06)
      drop-shadow(0 0 26px oklch(0.74 0.155 65 / 0.45))
      drop-shadow(8px 12px 14px oklch(0.04 0.003 65 / 0.55));
    transform: scale(1.025);
  }

  .products:has(.product-link--bulb:hover) .product--bulb .cutout-wrap,
  .products:has(.product-link--bulb:focus-visible) .product--bulb .cutout-wrap {
    filter:
      brightness(1.32)
      saturate(1.22)
      drop-shadow(0 0 36px oklch(0.74 0.155 65 / 0.65))
      drop-shadow(0 0 14px oklch(0.82 0.085 78 / 0.45))
      drop-shadow(8px 12px 14px oklch(0.04 0.003 65 / 0.55));
    transform: scale(1.025);
    transition:
      filter var(--dur-cinematic) var(--ease-illuminate),
      transform var(--dur-considered) var(--ease-focus-pull);
  }

  .products:has(.product-link--mic:hover) .product--binder .cutout-wrap,
  .products:has(.product-link--mic:focus-visible) .product--binder .cutout-wrap,
  .products:has(.product-link--bulb:hover) .product--binder .cutout-wrap,
  .products:has(.product-link--bulb:focus-visible) .product--binder .cutout-wrap {
    filter:
      blur(2.5px)
      brightness(0.86)
      saturate(0.92);
    transform: none;
  }

  /* Captions */
  .caption {
    display: flex;
    flex-direction: column;
    align-items: center;
    margin-top: var(--cap-gap, 0.5rem);
    text-align: center;
    transition:
      opacity var(--dur-quick) var(--ease-focus-pull),
      color var(--dur-quick) var(--ease-focus-pull);
    opacity: 0.7;
  }

  .name {
    font-family: var(--font-display);
    font-size: var(--fs-small);
    color: var(--ink);
    font-weight: 600;
    line-height: 1.2;
    white-space: nowrap;
  }

  .product.is-default .caption,
  .products:has(.product-link--binder:hover) .product--binder .caption,
  .products:has(.product-link--binder:focus-visible) .product--binder .caption,
  .products:has(.product-link--mic:hover) .product--mic .caption,
  .products:has(.product-link--mic:focus-visible) .product--mic .caption,
  .products:has(.product-link--bulb:hover) .product--bulb .caption,
  .products:has(.product-link--bulb:focus-visible) .product--bulb .caption {
    opacity: 1;
  }

  .product.is-default .name,
  .products:has(.product-link--binder:hover) .product--binder .name,
  .products:has(.product-link--binder:focus-visible) .product--binder .name,
  .products:has(.product-link--mic:hover) .product--mic .name,
  .products:has(.product-link--mic:focus-visible) .product--mic .name,
  .products:has(.product-link--bulb:hover) .product--bulb .name,
  .products:has(.product-link--bulb:focus-visible) .product--bulb .name {
    color: var(--key-light);
  }

  .products:has(.product-link--mic:hover) .product--binder .caption,
  .products:has(.product-link--mic:focus-visible) .product--binder .caption,
  .products:has(.product-link--bulb:hover) .product--binder .caption,
  .products:has(.product-link--bulb:focus-visible) .product--binder .caption {
    opacity: 0.7;
  }

  .products:has(.product-link--mic:hover) .product--binder .name,
  .products:has(.product-link--mic:focus-visible) .product--binder .name,
  .products:has(.product-link--bulb:hover) .product--binder .name,
  .products:has(.product-link--bulb:focus-visible) .product--binder .name {
    color: var(--ink);
  }

  /* Tip — hover-revealed description anchored above the cutout */
  .tip {
    position: absolute;
    bottom: calc(100% + 0.5rem);
