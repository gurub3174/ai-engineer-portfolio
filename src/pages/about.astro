---
import { Picture } from 'astro:assets';
import ContactCard from '@components/ContactCard.astro';
import NavMenu from '@components/NavMenu.astro';
import BaseLayout from '@layouts/BaseLayout.astro';
import portrait from '../assets/about/portrait.jpg';

/*
 * About — tight identity statement: eyebrow + title beside the portrait,
 * bio spanning the full measure below both, contact card to close.
 */
---

<BaseLayout
  title="About · Guru Balamurugan"
  description="AI engineer Monday to Friday, photographer on the weekend. NYC based. A data-engineering foundation applied to building AI systems that hold up in production."
>
  <a href="#identity" class="skip-link">Skip to the about content</a>

  <header class="site-nav">
    <div class="nav-left">
      <a class="identity" href="/" aria-label="Guru Balamurugan, home">
        <span class="identity-name">Guru Balamurugan</span>
        <span class="identity-sep" aria-hidden="true">·</span>
        <span class="identity-role">AI Engineer</span>
      </a>
      <NavMenu current="about" />
    </div>

    <nav class="primary-nav" aria-label="Primary">
      <a href="/#studio">Projects</a>
      <a href="/resume">Resume</a>
      <a href="/about" aria-current="page">About</a>
      <a href="/about#get-in-touch">Contact</a>
    </nav>

    <a class="return-link" href="/#studio">
      <span aria-hidden="true">←</span> Back to projects
    </a>
  </header>

  <main>
    <article id="identity" class="about" aria-labelledby="about-title">
      <header class="about-head">
        <p class="about-eyebrow">NYC based</p>
        <h1 id="about-title" class="about-title">
          AI Engineer <span class="nowrap">M-F</span>, Photographer on the Weekend.
        </h1>
      </header>

      <figure class="portrait">
        <Picture
          src={portrait}
          alt="Portrait of Guru Balamurugan."
          widths={[360, 480, 720, 960]}
          sizes="(min-width: 720px) 360px, 60vw"
          formats={['avif', 'webp']}
          quality={70}
          loading="eager"
          fetchpriority="high"
        />
      </figure>

      <div class="about-bio">
        <p>
          I started as a data engineer, building Python pipelines, Snowflake
          models, and dbt transformations that turned messy, sparse data into
          clean client-ready marts. That work made me allergic to AI fluff. I
          like a good demo as much as anyone, but I care more about what happens
          when the system fails. We treat data pipelines that way, so why should
          AI pipelines be any different? It is why I built a document extractor
          as a deterministic, governed tool, not a prototype that looks great
          until it meets a real document.
        </p>
        <p>
          Now I am building an AI design team around the same belief: a model is
          only as good as its input. Every project at work has a PM and
          documentation, and models deserve the same. Specs, artifacts,
          constraints, and asking "why" are what make vibe coding actually hold
          up. My spicy take: AI will replace us, so do not be the one getting
          dumber with every prompt. Think while you build.
        </p>
      </div>

      <div class="about-contact">
        <ContactCard />
      </div>
    </article>
  </main>

  <footer class="page-footer">
    <ul class="footer-links" role="list">
      <li><a href="https://github.com/" rel="me noreferrer">GitHub</a></li>
      <li><a href="https://www.linkedin.com/in/guru17/" rel="me noreferrer">LinkedIn</a></li>
      <li><a href="/resume">Resume</a></li>
      <li><a href="/about#get-in-touch">Contact</a></li>
    </ul>
    <p class="footer-meta">Astro · Cloudflare Pages · open source · 2026</p>
  </footer>
</BaseLayout>

<style>
  .skip-link {
    position: absolute;
    left: var(--container-edge);
    top: var(--container-edge);
    padding: var(--space-snug) var(--space-base);
    background: var(--surface-raised);
    color: var(--key-light);
    border: 1px solid var(--border-key);
    border-radius: 2px;
    z-index: 300;
    transform: translateY(-200%);
    transition: transform var(--dur-quick) var(--ease-focus-pull);
  }
  .skip-link:focus-visible {
    transform: translateY(0);
  }

  .site-nav,
  .about,
  .page-footer {
    width: 100%;
    max-width: var(--container-wide);
    margin-inline: auto;
    padding-inline: var(--container-edge);
  }

  .site-nav {
    padding-top: var(--space-roomy);
    padding-bottom: var(--space-roomy);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-loose);
    flex-wrap: wrap;
  }

  .nav-left {
    display: inline-flex;
    align-items: center;
    gap: var(--space-base);
  }

  .return-link {
    display: none;
    font-family: var(--font-mono);
    font-size: var(--fs-caption);
    letter-spacing: var(--ls-meta-allcaps);
    text-transform: uppercase;
    color: var(--ink-muted);
    text-decoration: none;
    align-items: center;
    gap: 0.5ch;
    min-height: 44px;
  }
  .return-link:hover,
  .return-link:focus-visible {
    color: var(--key-light);
  }

  .identity {
    display: inline-flex;
    align-items: baseline;
    gap: var(--space-snug);
    color: var(--ink-strong);
    text-decoration: none;
    font-family: var(--font-mono);
    font-size: var(--fs-caption);
    letter-spacing: var(--ls-meta-allcaps);
    text-transform: uppercase;
    min-height: 44px;
  }

  .identity-sep {
    color: var(--key-light);
  }

  .identity-role {
    color: var(--ink-muted);
  }

  .primary-nav {
    display: inline-flex;
    align-items: center;
    gap: var(--space-loose);
    flex-wrap: wrap;
  }

  .primary-nav a {
    font-family: var(--font-mono);
    font-size: var(--fs-caption);
    color: var(--ink-muted);
    letter-spacing: var(--ls-meta-allcaps);
    text-transform: uppercase;
    text-decoration: none;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    border-bottom: 1px solid transparent;
    transition:
      color var(--dur-quick) var(--ease-focus-pull),
      border-color var(--dur-quick) var(--ease-focus-pull);
  }

  .primary-nav a:hover,
  .primary-nav a:focus-visible {
    color: var(--ink-strong);
    border-bottom-color: var(--key-light);
  }

  .primary-nav a[aria-current='page'] {
    color: var(--ink-strong);
    border-bottom-color: var(--key-light);
  }

  .about {
    padding-top: var(--space-spacious);
    padding-bottom: var(--space-roomy);
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-loose);
  }

  .about-eyebrow {
    font-family: var(--font-mono);
    font-size: var(--fs-caption);
    color: var(--ink-faint);
    letter-spacing: var(--ls-meta-allcaps);
    text-transform: uppercase;
    margin: 0 0 var(--space-base);
  }

  .about-title {
    font-family: var(--font-display);
    font-size: var(--fs-display);
    font-weight: 600;
    line-height: 1.04;
    letter-spacing: var(--ls-display);
    color: var(--ink-strong);
    margin: 0;
    max-width: 18ch;
    text-wrap: balance;
  }

  /* Keep "M-F" from breaking across lines at the hyphen. */
  .nowrap {
    white-space: nowrap;
  }

  .about-bio {
    margin: 0;
    max-width: 68ch;
    display: grid;
    gap: var(--space-base);
  }

  .about-bio p {
    margin: 0;
    color: var(--ink-muted);
    font-family: var(--font-body);
    font-size: var(--fs-body);
    line-height: 1.65;
  }

  .about-bio p:first-child {
    color: var(--ink);
    font-size: var(--fs-body-lg);
    line-height: 1.55;
  }

  .portrait {
    margin: 0;
    padding: 0;
    max-width: 320px;
  }

  .portrait :global(img) {
    width: 100%;
    height: auto;
    display: block;
    border-radius: 2px;
    box-shadow: 0 24px 60px -32px oklch(0.05 0.008 65 / 0.45);
  }

  .page-footer {
    padding-top: var(--space-spacious);
    padding-bottom: var(--space-roomy);
    border-top: 1px solid var(--border-hairline);
    margin-top: var(--space-roomy);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-base);
    text-align: center;
  }

  .footer-line {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--fs-body-lg);
    font-style: italic;
    color: var(--ink-muted);
  }

  .footer-links {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-loose);
  }

  .footer-links a {
    font-family: var(--font-body);
    font-size: var(--fs-small);
    color: var(--ink-muted);
  }

  .footer-meta {
    margin: 0;
    font-family: var(--font-mono);
    font-size: var(--fs-caption);
    color: var(--ink-faint);
    letter-spacing: 0.02em;
  }

  /* Sticky header + dropdown nav on phones (matches NavMenu's 640 breakpoint). */
  @media (max-width: 640px) {
    .site-nav {
      position: sticky;
      top: 0;
      z-index: 100;
      padding-top: var(--space-base);
      padding-bottom: var(--space-base);
      background: var(--bg-stage);
      border-bottom: 1px solid var(--border-hairline);
    }
    .primary-nav {
      display: none;
    }
    .return-link {
      display: inline-flex;
    }
    .about {
      padding-top: var(--space-loose);
    }
  }

  /* Mobile: portrait centered on top, then title, then bio, scroll down.
     `order` only affects the single-column flow here; the >=720px grid below
     places items by grid-area, so desktop is untouched. */
  @media (max-width: 719px) {
    .portrait {
      order: -1;
      margin-inline: auto;
    }
    .about-head {
      text-align: center;
    }
    .about-title {
      margin-inline: auto;
    }
  }

  /* Tight two-up: title beside portrait, bio + contact span full width below. */
  @media (min-width: 720px) {
    /* Unified gap x: title sits close beside the portrait, and the bio sits the
       same x below them (= the title-to-bio gap). */
    .about {
      /* Portrait column hugs the image (auto) so it sits right beside the
         title instead of pinned to the far right with a wide empty gap. */
      grid-template-columns: minmax(0, 1fr) auto;
      grid-template-areas:
        'head portrait'
        'bio bio'
        'contact contact';
      column-gap: var(--space-loose);
      row-gap: var(--space-loose);
      align-items: start;
    }

    .about-head {
      grid-area: head;
      align-self: center;
    }

    .portrait {
      grid-area: portrait;
      justify-self: end;
    }

    /* Bio runs the full width to the picture's right edge (no 68ch clamp). */
    .about-bio {
      grid-area: bio;
      max-width: none;
    }

    .about-contact {
      grid-area: contact;
    }
  }
</style>
